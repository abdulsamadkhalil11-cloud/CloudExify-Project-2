<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.controller.StudentFormController" spacing="16" styleClass="card" prefWidth="480">
    <Label fx:id="formTitleLabel" text="Register Student" styleClass="login-title"/>

    <Label fx:id="formErrorLabel" styleClass="login-error-banner" wrapText="true" maxWidth="Infinity"
           managed="false" visible="false"/>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <StackPane style="-fx-padding: 4;">
            <ImageView fx:id="photoPreview" fitWidth="72" fitHeight="72" preserveRatio="true"/>
        </StackPane>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Photo (optional)" styleClass="form-label"/>
            <HBox spacing="8">
                <TextField fx:id="photoPathField" styleClass="text-field" HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false"/>
                <Button fx:id="browsePhotoButton" text="Browse..." styleClass="btn-outline" onAction="#handleBrowsePhoto"/>
            </HBox>
        </VBox>
    </HBox>

    <GridPane hgap="14" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
            <Label text="Full name *" styleClass="form-label"/>
            <TextField fx:id="fullNameField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Student number *" styleClass="form-label"/>
            <TextField fx:id="studentNumberField" styleClass="text-field" promptText="e.g. FA25-BSE-011" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Department *" styleClass="form-label"/>
            <TextField fx:id="departmentField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Semester *" styleClass="form-label"/>
            <Spinner fx:id="semesterSpinner" editable="true" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Status" styleClass="form-label"/>
            <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Phone" styleClass="form-label"/>
            <TextField fx:id="phoneField" styleClass="text-field" promptText="03XXXXXXXXX" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Email" styleClass="form-label"/>
            <TextField fx:id="emailField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancel" styleClass="btn-outline" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Save Student" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
