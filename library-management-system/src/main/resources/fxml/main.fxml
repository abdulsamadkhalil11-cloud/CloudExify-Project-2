<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.controller.MainController" styleClass="root-bg">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-logo-box">
                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                    <Image url="@../images/app-icon.png"/>
                </ImageView>
                <Label text="LibraSys" styleClass="brand-title" style="-fx-font-size: 16px;"/>
            </HBox>

            <Button fx:id="navDashboard" text="Dashboard" contentDisplay="LEFT" maxWidth="Infinity"
                    styleClass="sidebar-nav-item, sidebar-nav-item-active" onAction="#showDashboard">
                <graphic>
                    <SVGPath styleClass="icon-svg-sidebar"
                             content="M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M3 14 H10 V21 H3 Z M14 14 H21 V21 H14 Z"/>
                </graphic>
            </Button>
            <Button fx:id="navBooks" text="Books" contentDisplay="LEFT" maxWidth="Infinity"
                    styleClass="sidebar-nav-item" onAction="#showBooks">
                <graphic>
                    <SVGPath styleClass="icon-svg-sidebar" content="M4 4 L11 4 L11 20 L4 18 Z M20 4 L13 4 L13 20 L20 18 Z"/>
                </graphic>
            </Button>
            <Button fx:id="navStudents" text="Students" contentDisplay="LEFT" maxWidth="Infinity"
                    styleClass="sidebar-nav-item" onAction="#showStudents">
                <graphic>
                    <SVGPath styleClass="icon-svg-sidebar" content="M12 3 L16 7 L12 11 L8 7 Z M5 21 L5 16 L19 16 L19 21 Z"/>
                </graphic>
            </Button>
            <Button fx:id="navIssueReturn" text="Issue / Return" contentDisplay="LEFT" maxWidth="Infinity"
                    styleClass="sidebar-nav-item" onAction="#showIssueReturn">
                <graphic>
                    <SVGPath styleClass="icon-svg-sidebar"
                             content="M2 5 L14 5 L14 2 L21 6.5 L14 11 L14 8 L2 8 Z M22 16 L10 16 L10 13 L3 17.5 L10 22 L10 19 L22 19 Z"/>
                </graphic>
            </Button>

            <Label text="SYSTEM" styleClass="sidebar-section-label"/>

            <Button fx:id="navSettings" text="Settings" contentDisplay="LEFT" maxWidth="Infinity"
                    styleClass="sidebar-nav-item" onAction="#showSettings">
                <graphic>
                    <SVGPath styleClass="icon-svg-sidebar" content="M8 3 L16 3 L21 8 L21 16 L16 21 L8 21 L3 16 L3 8 Z"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-footer" spacing="10">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="avatar-circle">
                        <Label fx:id="userInitialsLabel" text="A" styleClass="avatar-initials"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label fx:id="userNameLabel" text="Staff Name" styleClass="sidebar-user-name"/>
                        <Label fx:id="userRoleLabel" text="Role" styleClass="sidebar-user-role"/>
                    </VBox>
                </HBox>
                <Button fx:id="navLogout" text="Log out" contentDisplay="LEFT" maxWidth="Infinity"
                        styleClass="sidebar-nav-item" onAction="#handleLogout" style="-fx-padding: 8 8 8 8;">
                    <graphic>
                        <SVGPath styleClass="icon-svg-sidebar" content="M2 7 L13 7 L13 3 L22 12 L13 21 L13 17 L2 17 Z"/>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <Label fx:id="pageHeaderLabel" text="Dashboard" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="themeToggleButton" text="&#9728;" styleClass="icon-btn" onAction="#handleThemeToggle">
                <tooltip>
                    <Tooltip text="Toggle light / dark mode"/>
                </tooltip>
            </Button>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER"/>
    </center>
</BorderPane>
