<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.controller.StudentManagementController" spacing="16">

    <HBox alignment="CENTER_LEFT">
        <Label text="Register students, keep contact details current, and track account status." styleClass="page-subtitle" wrapText="true" maxWidth="520"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addStudentButton" text="+ Register Student" styleClass="btn-accent" onAction="#handleAddStudent"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card">
        <TextField fx:id="searchField" promptText="Search by name, student number or email..." styleClass="search-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="clearFiltersButton" text="Clear" styleClass="btn-outline" onAction="#handleClearFilters"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colStudentNumber" text="Student #" prefWidth="110"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="160"/>
                <TableColumn fx:id="colDepartment" text="Department" prefWidth="150"/>
                <TableColumn fx:id="colSemester" text="Sem" prefWidth="50"/>
                <TableColumn fx:id="colPhone" text="Phone" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="130"/>
            </columns>
            <placeholder>
                <Label text="No students found" styleClass="empty-state-text"/>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="pagination-bar">
            <Button fx:id="prevPageButton" text="Previous" styleClass="btn-outline" onAction="#handlePrevPage"/>
            <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="page-indicator-label"/>
            <Button fx:id="nextPageButton" text="Next" styleClass="btn-outline" onAction="#handleNextPage"/>
        </HBox>
    </VBox>
</VBox>
