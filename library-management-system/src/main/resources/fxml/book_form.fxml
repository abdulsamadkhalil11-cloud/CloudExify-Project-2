<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.controller.BookFormController" spacing="16" styleClass="card" prefWidth="520">
    <Label fx:id="formTitleLabel" text="Add Book" styleClass="login-title"/>

    <Label fx:id="formErrorLabel" styleClass="login-error-banner" wrapText="true" maxWidth="Infinity"
           managed="false" visible="false"/>

    <HBox spacing="20">
        <StackPane styleClass="card" style="-fx-padding: 8;">
            <ImageView fx:id="coverPreview" fitWidth="90" fitHeight="128" preserveRatio="true"/>
        </StackPane>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Cover image path (optional)" styleClass="form-label"/>
            <HBox spacing="8">
                <TextField fx:id="coverPathField" styleClass="text-field" HBox.hgrow="ALWAYS" maxWidth="Infinity" editable="false"/>
                <Button fx:id="browseCoverButton" text="Browse..." styleClass="btn-outline" onAction="#handleBrowseCover"/>
            </HBox>
            <Label text="PNG or JPG. Shown in place of the default cover placeholder." styleClass="muted-text" wrapText="true"/>
        </VBox>
    </HBox>

    <GridPane hgap="14" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
            <Label text="Title *" styleClass="form-label"/>
            <TextField fx:id="titleField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="ISBN *" styleClass="form-label"/>
            <TextField fx:id="isbnField" styleClass="text-field" promptText="10 or 13 digits" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Shelf location" styleClass="form-label"/>
            <TextField fx:id="shelfField" styleClass="text-field" promptText="e.g. CS-101" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Author *" styleClass="form-label"/>
            <HBox spacing="6">
                <ComboBox fx:id="authorCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="addAuthorButton" text="+" styleClass="btn-outline" onAction="#handleAddAuthor"/>
            </HBox>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Category *" styleClass="form-label"/>
            <HBox spacing="6">
                <ComboBox fx:id="categoryCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="addCategoryButton" text="+" styleClass="btn-outline" onAction="#handleAddCategory"/>
            </HBox>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Publisher" styleClass="form-label"/>
            <TextField fx:id="publisherField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Label text="Publication year" styleClass="form-label"/>
            <TextField fx:id="yearField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="4">
            <Label text="Edition" styleClass="form-label"/>
            <TextField fx:id="editionField" styleClass="text-field" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <Label text="Total copies *" styleClass="form-label"/>
            <Spinner fx:id="totalCopiesSpinner" editable="true" maxWidth="Infinity"/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancel" styleClass="btn-outline" onAction="#handleCancel"/>
        <Button fx:id="saveButton" text="Save Book" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
